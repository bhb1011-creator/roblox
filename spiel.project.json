{
  "name": "GanzesSpiel",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$attributes": {
        "FullGame": true
      },
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$ignoreUnknownInstances": false,
      "Kapitel1": {
        "$path": "src/level/server"
      },
      "Kapitel2": {
        "$path": "src/kapitel2/server",
