          "Choices": {
            "$path": "src/level/client/Choices.lua"
          },
          "Ambience": {
            "$path": "src/level/client/Ambience.lua"
          }
        },
        "Spiel": {
          "$path": "src/spiel/client"
        },
        "Lobby": {
          "$path": "src/lobby/client"
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future"
