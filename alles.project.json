{
  "name": "LobbyUndSpiel",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$attributes": {
        "FullGame": true,
        "Combined": true
      },
      "Shared": {
        "$path": "src/shared"
      },
      "Wagners": {
        "$path": "assets/figuren"
      },
      "Spieler": {
        "$path": "assets/spieler"
      },
      "Sarp": {
        "$path": "assets/sarp"
      },
      "Natur": {
        "$path": "assets/natur"
      },
