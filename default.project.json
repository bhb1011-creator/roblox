{
  "name": "HorrorLobby",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Spieler": {
        "$path": "assets/spieler"
      }
    },
    "ServerScriptService": {
      "$ignoreUnknownInstances": false,
      "Lobby": {
        "$path": "src/lobby/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$ignoreUnknownInstances": false,
        "Lobby": {
          "$path": "src/lobby/client"
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future"
      }
    }
  }
}
